{
  "expo": {
    "name": "باقات",
    "slug": "baqat-riyadh",
    "version": "1.0.0",
    "orientation": "portrait",
    "ios": {
      "bundleIdentifier": "com.alvra.baqat",
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.alvra.baqat"
    },
    "extra": {
      "eas": {
        "projectId": "dd06d12f-ab00-45a8-be3a-67bc987b9400"
      }
    },
    "owner": "nader-fahad",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "تستخدم باقات الكاميرا لقراءة رمز الباقة لدى المطعم.",
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "barcodeScannerEnabled": true
        }
      ]
    ]
  }
}
